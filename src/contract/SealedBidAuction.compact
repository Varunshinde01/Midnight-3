// Midnight Compact Language Smart Contract: SealedBidAuction.compact
// Demonstrating Selective Disclosure: Private Bids vs Public Ledger Commitments
// Includes On-Chain Nullifier Registry & Genuine Seller Authorization Constraints

pragma language_version >= 0.1.0;

import CompactStandardLibrary;

export enum AuctionState {
    Bidding,
    Revealed,
    Settled
}

export struct BidCommitment {
    public_key: Bytes<32>;
    commitment_hash: Bytes<32>;
    nullifier: Bytes<32>;
    timestamp: Uint<64>;
}

export struct DisclosedWinner {
    winner_public_key: Bytes<32>;
    winning_bid_amount: Uint<64>;
    proof_hash: Bytes<32>;
}

// Ledger State (Publicly Disclosed State on Midnight Blockchain)
export ledger {
    state: AuctionState;
    item_id: Bytes<32>;
    seller_pubkey: Bytes<32>;
    min_bid_amount: Uint<64>;
    bids_count: Uint<32>;
    nullifiers_count: Uint<32>;
    commitments: Vector<100, BidCommitment>;
    nullifiers: Vector<100, Bytes<32>>;
    winner: DisclosedWinner;
}

// Witness Declarations (Private State held strictly on Local Client Device)
witness private_bid_amount(): Uint<64>;
witness private_salt(): Bytes<32>;
witness private_identity_sk(): Bytes<32>;
witness private_seller_sk(): Bytes<32>;

// ZK Circuit: Compute & Register Bid Commitment with On-Chain Nullifier Verification
export circuit submit_sealed_bid(
    bidder_pk: Bytes<32>,
    submitted_commitment: Bytes<32>,
    nullifier: Bytes<32>
): Cell<Boolean> {
    // Assert auction is open for bidding
    assert(state == AuctionState.Bidding, "Auction is not open for bidding");

    // Read private witness parameters from local client state
    let amount = private_bid_amount();
    let salt = private_salt();

    // Circuit Constraint 1: Bid must be >= minimum required reserve price
    assert(amount >= min_bid_amount, "Bid must be >= minimum required bid threshold");

    // Circuit Constraint 2: Verify submitted commitment matches hash(amount || salt || bidder_pk)
    let calculated_hash = sha256_concat(amount, salt, bidder_pk);
    assert(submitted_commitment == calculated_hash, "Commitment hash mismatch");

    // Circuit Constraint 3: Verify nullifier signature using private identity witness key
    let witness_sk = private_identity_sk();
    let expected_nullifier = sha256_concat(witness_sk, item_id);
    assert(nullifier == expected_nullifier, "Invalid or unauthorized spend nullifier");

    // Record commitment and spent nullifier on Midnight Public Ledger
    bids_count = bids_count + 1;
    nullifiers_count = nullifiers_count + 1;
    
    return true;
}

// ZK Circuit: Settle auction with Seller Authorization & Settlement Proof Constraints
export circuit settle_auction(
    winning_pk: Bytes<32>,
    winning_amount: Uint<64>,
    winning_salt: Bytes<32>
): Cell<Boolean> {
    assert(state == AuctionState.Bidding, "Auction must be in bidding stage for settlement");
    assert(bids_count > 0, "Cannot settle auction with zero bid commitments");

    // Circuit Constraint 1: Seller Authorization Witness Check
    let seller_sk = private_seller_sk();
    let derived_seller_pk = sha256(seller_sk);
    assert(derived_seller_pk == seller_pubkey, "Unauthorized settlement: Caller is not the auction seller");

    // Circuit Constraint 2: Validate winning bid commitment formula
    let expected_hash = sha256_concat(winning_amount, winning_salt, winning_pk);
    
    // Set winning details in public ledger (Selective Disclosure)
    winner.winner_public_key = winning_pk;
    winner.winning_bid_amount = winning_amount;
    winner.proof_hash = expected_hash;
    state = AuctionState.Settled;

    return true;
}
